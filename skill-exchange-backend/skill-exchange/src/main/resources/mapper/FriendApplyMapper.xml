<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillexchange.mapper.FriendApplyMapper">

    <resultMap id="BaseResultMap" type="com.skillexchange.entity.FriendApply">
        <id column="id" property="id"/>
        <result column="from_user_id" property="fromUserId"/>
        <result column="to_user_id" property="toUserId"/>
        <result column="status" property="status"/>
        <result column="message" property="message"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, from_user_id, to_user_id, status, message, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.skillexchange.entity.FriendApply" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO friend_apply (from_user_id, to_user_id, status, message)
        VALUES (#{fromUserId}, #{toUserId}, #{status}, #{message})
    </insert>

    <update id="updateStatus">
        UPDATE friend_apply SET status = #{status}, update_time = NOW() WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM friend_apply WHERE id = #{id}
    </select>

    <select id="selectByFromUserId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM friend_apply WHERE from_user_id = #{fromUserId} ORDER BY create_time DESC
    </select>

    <select id="selectByToUserId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM friend_apply WHERE to_user_id = #{toUserId} ORDER BY create_time DESC
    </select>

    <select id="selectByFromUserIdAndToUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM friend_apply
        WHERE from_user_id = #{fromUserId} AND to_user_id = #{toUserId}
    </select>

    <select id="countByToUserIdAndStatus" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM friend_apply WHERE to_user_id = #{toUserId} AND status = #{status}
    </select>

</mapper>