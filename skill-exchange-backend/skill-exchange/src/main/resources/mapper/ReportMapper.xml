<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skillexchange.mapper.ReportMapper">

    <resultMap id="BaseResultMap" type="com.skillexchange.entity.Report">
        <id column="id" property="id"/>
        <result column="reporter_id" property="reporterId"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="reason" property="reason"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="handle_result" property="handleResult"/>
        <result column="handle_time" property="handleTime"/>
        <result column="handler_id" property="handlerId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, reporter_id, target_type, target_id, reason, description, status, handle_result, handle_time, handler_id, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.skillexchange.entity.Report" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO report (reporter_id, target_type, target_id, reason, description, status)
        VALUES (#{reporterId}, #{targetType}, #{targetId}, #{reason}, #{description}, #{status})
    </insert>

    <update id="updateStatus">
        UPDATE report
        SET status = #{status},
            handle_result = #{handleResult},
            handle_time = #{handleTime},
            handler_id = #{handlerId},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM report WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM report ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM report WHERE status = #{status} ORDER BY create_time DESC
    </select>

    <select id="selectByReporterId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM report WHERE reporter_id = #{reporterId} ORDER BY create_time DESC
    </select>

    <select id="countByStatus" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM report WHERE status = #{status}
    </select>

    <select id="countAll" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM report
    </select>

</mapper>